@startuml
 title uc — Validate HappiHub revisions
 left to right direction
 actor Contributor
 actor Maintainer
 rectangle "HappiHub quality control" {
 usecase "UC1 Validate a pushed revision" as UC1
 usecase "UC2 Inspect quality findings" as UC2
 usecase "UC3 Renew analysis credential" as UC3
 }
 Contributor --> UC1
 Maintainer --> UC2
 Maintainer --> UC3
@enduml

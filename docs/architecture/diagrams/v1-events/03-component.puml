@startuml
title cmp — HappiHub V1 components (technology-neutral data store)
skinparam shadowing false
skinparam componentStyle uml2
left to right direction

actor "Member / visitor" as U
node "Partner website server" as P

component "React browser client" as C
component "Nginx trusted ingress\n(ADR-0002)" as N

package "API server process (single instance)" {
  package "HTTP modules" {
    component "Auth & sessions\n(ADR-0001, CSRF)" as AUTH
    component "Events" as EV
    component "Membership" as MEM
    component "Moderation" as MOD
    component "Public read" as PUB
    component "Partner API\n(read-only, hashed keys)" as PAPI
  }
  package "Scheduled jobs (runOnce)" {
    component "Maintenance job\n(hourly, lock)" as MJ
  }
  package "Domain core" {
    component "Domain model & rules\n(class diagram 04)" as DOM
    interface "Repositories" as IREPO
    interface "Outbox" as IOUT
    interface "AddressLookup" as IADDR
    interface "FileStore" as IFILE
    interface "Clock" as ICLK
  }
  package "Adapters" {
    component "Data store adapter" as ADB
    component "File store adapter" as AFS
    component "Address provider adapter\n(debounced, cached, 429-aware)" as AADDR
    package "Email delivery" {
      component "Outbox worker\n(every minute, runOnce, retries)" as OW
      interface "EmailSender" as IMAIL
      component "Email provider adapter" as AMAIL
    }
    component "System clock" as ACLK
  }
}

database "Data store\n(technology open, #246)" as DB
storage "File storage\n(realization open)" as FS
cloud "Address suggestion provider\n(Géoplateforme, free)" as XADDR
cloud "Email provider\n(EU, to be selected)" as XMAIL

U --> C : HTTPS
C --> N : JSON + cookie + CSRF
P --> N : Bearer key (server to server)
N --> AUTH
N --> EV
N --> MEM
N --> MOD
N --> PUB
N --> PAPI

AUTH ..> DOM
EV ..> DOM
MEM ..> DOM
MOD ..> DOM
PUB ..> DOM
PAPI ..> DOM
OW ..> IOUT : drain
OW ..> IMAIL
MJ ..> DOM

DOM ..> IREPO
DOM ..> IOUT
DOM ..> IADDR
DOM ..> IFILE
DOM ..> ICLK

ADB -up-|> IREPO
ADB -up-|> IOUT
AFS -up-|> IFILE
AADDR -up-|> IADDR
AMAIL -up-|> IMAIL
ACLK -up-|> ICLK

ADB --> DB
AFS --> FS
AADDR --> XADDR : HTTPS, no visitor IP
AMAIL --> XMAIL : HTTPS

note bottom of DOM
  Dependency rule: domain owns the ports;
  adapters depend on them, never the reverse.
end note
@enduml

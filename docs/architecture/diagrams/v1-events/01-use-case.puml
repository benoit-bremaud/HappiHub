@startuml
title uc — HappiHub V1
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Visitor\n(Inès)" as Visitor
actor "Registered user" as Registered
actor "Association member\n(Claire, Malik)" as Member
actor "Partner website\n(troupe's WordPress)" as Partner <<system>>
actor "Moderator" as Moderator
actor "Super administrator\n(owner)" as SuperAdmin

Registered -|> Visitor
Member -|> Registered
Moderator -|> Registered
SuperAdmin -|> Moderator

rectangle "HappiHub V1" {
  package "Account and association" {
    usecase "UC1 Sign up an association" as UC1
    usecase "UC2 Verify email address" as UC2
    usecase "UC3 Reset a forgotten password" as UC3
    usecase "UC4 Update my account" as UC4
    usecase "UC5 Export my data" as UC5
    usecase "UC6 Delete my account" as UC6
    usecase "UC7 Edit the association profile" as UC7
    usecase "UC8 Close the association" as UC8
    usecase "UC9 Dispute a\nmoderation decision" as UC9
  }
  package "Membership" {
    usecase "UC10 Manage invitations" as UC10
    usecase "UC11 Join an association\nfrom an invitation" as UC11
    usecase "UC12 Remove a member\nor leave the association" as UC12
    usecase "UC13 Dispute a removal" as UC13
    usecase "UC14 Consult the activity log" as UC14
  }
  package "Event management" {
    usecase "UC15 Create an event" as UC15
    usecase "UC16 Edit an event" as UC16
    usecase "UC17 Resolve an edit conflict" as UC17
    usecase "UC18 Publish an event" as UC18
    usecase "UC19 Cancel an event" as UC19
    usecase "UC20 Delete a draft" as UC20
  }
  package "Public browsing" {
    usecase "UC21 Browse upcoming events" as UC21
    usecase "UC22 View an event page" as UC22
    usecase "UC23 Share an event" as UC23
    usecase "UC24 Add an event to a calendar" as UC24
    usecase "UC25 View an association page" as UC25
    usecase "UC26 Report an event\nor an association" as UC26
  }
  package "Website integration" {
    usecase "UC27 Manage API keys" as UC27
    usecase "UC28 Retrieve association events" as UC28
  }
  package "Administration" {
    usecase "UC29 Handle a report" as UC29
    usecase "UC30 Resolve a removal dispute" as UC30
    usecase "UC31 Suspend an account\nor an association" as UC31
    usecase "UC32 Resolve a\nmoderation dispute" as UC32
    usecase "UC33 Grant or revoke\nthe moderator role" as UC33
  }
}

Visitor --> UC1
Visitor --> UC11
Visitor --> UC21
Visitor --> UC22
Visitor --> UC23
Visitor --> UC24
Visitor --> UC25
Visitor --> UC26

Registered --> UC2
Registered --> UC3
Registered --> UC13
Registered --> UC9
Registered --> UC6
Registered --> UC4
Registered --> UC5

Member --> UC7
Member --> UC10
Member --> UC12
Member --> UC14
Member --> UC15
Member --> UC16
Member --> UC18
Member --> UC19
Member --> UC20
Member --> UC27
Member --> UC8

Partner --> UC28

Moderator --> UC29
Moderator --> UC30
Moderator --> UC31

SuperAdmin --> UC33
SuperAdmin --> UC32

UC17 .> UC16 : <<extend>>\n(same field changed)
@enduml

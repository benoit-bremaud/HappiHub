@startuml
title uc — HappiHub V1
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Visitor\n(Inès)" as Visitor
actor "Registered user" as Registered
actor "Association member\n(Claire, Malik)" as Member
actor "Partner website\n(troupe's WordPress)" as Partner <<system>>
actor "Moderator" as Moderator
actor "Super administrator\n(owner)" as SuperAdmin

Registered -|> Visitor
Member -|> Registered
Moderator -|> Registered
SuperAdmin -|> Moderator

rectangle "HappiHub V1" {
  package "Account and association" {
    usecase "UC1 Sign up an association" as UC1
    usecase "UC2 Verify email address" as UC2
    usecase "UC3 Reset a forgotten password" as UC3
    usecase "UC4 Edit the association profile" as UC4
    usecase "UC27 Dispute a suspension" as UC27
  }
  package "Membership" {
    usecase "UC5 Invite a member" as UC5
    usecase "UC6 Join an association\nfrom an invitation" as UC6
    usecase "UC7 Remove a member\nor leave the association" as UC7
    usecase "UC8 Dispute a removal" as UC8
    usecase "UC9 Consult the activity log" as UC9
  }
  package "Event management" {
    usecase "UC10 Create an event" as UC10
    usecase "UC11 Edit an event" as UC11
    usecase "UC12 Resolve an edit conflict" as UC12
    usecase "UC13 Publish an event" as UC13
    usecase "UC14 Cancel an event" as UC14
    usecase "UC15 Delete a draft" as UC15
  }
  package "Public browsing" {
    usecase "UC16 View an event page" as UC16
    usecase "UC17 Share an event" as UC17
    usecase "UC18 Add an event to a calendar" as UC18
    usecase "UC19 View an association page" as UC19
    usecase "UC20 Report an event" as UC20
  }
  package "Website integration" {
    usecase "UC21 Manage API keys" as UC21
    usecase "UC22 Retrieve association events" as UC22
  }
  package "Administration" {
    usecase "UC23 Handle a report" as UC23
    usecase "UC24 Resolve a removal dispute" as UC24
    usecase "UC25 Suspend an account\nor an association" as UC25
    usecase "UC26 Grant or revoke\nthe moderator role" as UC26
  }
}

Visitor --> UC1
Visitor --> UC6
Visitor --> UC16
Visitor --> UC17
Visitor --> UC18
Visitor --> UC19
Visitor --> UC20

Registered --> UC2
Registered --> UC3
Registered --> UC8
Registered --> UC27

Member --> UC4
Member --> UC5
Member --> UC7
Member --> UC9
Member --> UC10
Member --> UC11
Member --> UC13
Member --> UC14
Member --> UC15
Member --> UC21

Partner --> UC22

Moderator --> UC23
Moderator --> UC24
Moderator --> UC25

SuperAdmin --> UC26

UC12 .> UC11 : <<extend>>\n(same field changed)
@enduml

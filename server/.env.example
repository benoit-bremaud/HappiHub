# Copy to an ignored environment file and configure the matching suffix.
# NODE_ENV is a runtime mode; environment tiers remain local/staging/prod.
# NODE_ENV=production selects the _PROD suffix, NODE_ENV=test selects _TEST, anything else _DEV.
# NODE_ENV=
# The schema is applied by the explicit operator step `npm run migrate` before `npm start`.
DATABASE_URL_DEV=postgres://happihub:change-me@127.0.0.1:5432/happihub_local
# Supply SESSION_SECRET_DEV through private runtime configuration.
APP_URL_DEV=http://localhost:3000
PORT_DEV=5000
# Field encryption keyring (path only; generate with `npm run keyring:generate -- .keys/field-keyring.dev.json`).
FIELD_KEYRING_FILE_DEV=.keys/field-keyring.dev.json

# Integration tests start their own disposable PostgreSQL (Docker); set TEST_DATABASE_URL to reuse one.
DATABASE_URL_TEST=
# Reuse an existing disposable PostgreSQL for integration tests instead of starting a container.
# TEST_DATABASE_URL=
# Supply SESSION_SECRET_TEST through private runtime configuration.
APP_URL_TEST=http://localhost:3000
PORT_TEST=5001
# Integration tests generate a throw-away keyring in memory; set this only to run the app in test mode.
FIELD_KEYRING_FILE_TEST=

DATABASE_URL_PROD=
# Mounted-secret alternatives: a file path whose content replaces the value at startup
# (`npm start` reads both; `npm run migrate` reads DATABASE_URL_<SUFFIX>_FILE).
# DATABASE_URL_PROD_FILE=
# SESSION_SECRET_PROD_FILE=
# Supply SESSION_SECRET_PROD through private runtime configuration.
APP_URL_PROD=
PORT_PROD=5000
# Keyring file outside the repository, mode 0400, owned by the service user; a copy lives in the
# password manager, never with backups. Boot is refused when it is missing or invalid.
FIELD_KEYRING_FILE_PROD=
# A remote database URL must carry sslmode=verify-full (loopback or a Unix socket are exempt).
# Production must use an HTTPS APP_URL. A trusted TLS gateway must have an explicit IP/CIDR.
# TRUSTED_PROXY=10.254.240.2
# Session secret: at least 32 random bytes, independently generated per environment.
# Production start is refused until a real email transport replaces the development log transport (T11a).

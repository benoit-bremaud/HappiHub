# Copy to an ignored environment file and configure the matching suffix.
# NODE_ENV is a runtime mode; environment tiers remain local/staging/prod.
MONGO_URI_DEV=mongodb://127.0.0.1:27017/happihub_local
# Supply JWT_SECRET_DEV through private runtime configuration.
JWT_EXPIRATION_DEV=15m
APP_URL_DEV=http://localhost:3000
PORT_DEV=5000

MONGO_URI_TEST=mongodb://127.0.0.1:27017/happihub_test
# Supply JWT_SECRET_TEST through private runtime configuration.
JWT_EXPIRATION_TEST=5m
APP_URL_TEST=http://localhost:3000
PORT_TEST=5001

MONGO_URI_PROD=
# Supply JWT_SECRET_PROD through private runtime configuration.
JWT_EXPIRATION_PROD=15m
APP_URL_PROD=
PORT_PROD=5000

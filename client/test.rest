# Use a private REST client cookie jar. Never save credentials, cookies or CSRF values here.
# Set csrfToken privately from the bootstrap response; update it after login regeneration.
GET http://localhost:5000/api/users/session
Origin: http://localhost:3000

###
POST http://localhost:5000/api/users/login
Origin: http://localhost:3000
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{"email":"organizer@example.com","password":"EXAMPLE_PASSWORD_ONLY"}

###
PUT http://localhost:5000/api/users/profile
Origin: http://localhost:3000
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{"name":"Example organizer"}

###
POST http://localhost:5000/api/users/logout
Origin: http://localhost:3000
X-CSRF-Token: {{csrfToken}}
Content-Type: application/json

{}

[Unit]
Description=Nightly local CI of HappiHub: just nightly, tier L3 (#410)
OnFailure=happihub-local-ci-nightly-failed.service

[Service]
Type=oneshot
# The user manager's PATH has no ~/.local/bin, where mise and sonar-scanner live; mise brings the pinned tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Documents/02_personal/HappiHub
ExecStart=%h/.local/bin/mise x -- just nightly
